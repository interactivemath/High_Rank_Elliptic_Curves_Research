        <mxCell id="EpTUFUEd36zy79XVS4MR-21" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;Input the Homogenized Cubic&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#75BAFF;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
