        <mxCell id="EpTUFUEd36zy79XVS4MR-27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="WIyWlLk6GJQsqaUBKTNV-1" source="EpTUFUEd36zy79XVS4MR-23" target="EpTUFUEd36zy79XVS4MR-26">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="EpTUFUEd36zy79XVS4MR-23" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;Use \(E = \text{EllipticCurve(F,P)}\), where \(P = [0,1,0]\), to find the Weierstrass form from the cubic.&amp;nbsp;&lt;/font&gt;" style="whiteSpace=wrap;html=1;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="497.5" y="94" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="EpTUFUEd36zy79XVS4MR-29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="WIyWlLk6GJQsqaUBKTNV-1" source="EpTUFUEd36zy79XVS4MR-26" target="EpTUFUEd36zy79XVS4MR-28">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="EpTUFUEd36zy79XVS4MR-26" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;Assume the Generalized Riemann Hypothesis&lt;/font&gt;" style="whiteSpace=wrap;html=1;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="545" y="206.5" width="185" height="60" as="geometry" />
        </mxCell>
        <mxCell id="EpTUFUEd36zy79XVS4MR-28" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;The upper bound of the analytic rank is the following sum as \(\text{(Bober, 2013)}\):&amp;nbsp;&lt;/font&gt;&lt;div style=&quot;font-size: 16px;&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;\[\sum_{\gamma} f_{\Delta}(\gamma) = g_{\text{an}}(\Delta, E) + u_{\text{an}} (\Delta) + n_{\text{an}} (\Delta, E)\]&lt;/font&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="60" y="175" width="390" height="125" as="geometry" />
        </mxCell>
        <mxCell id="EpTUFUEd36zy79XVS4MR-33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="WIyWlLk6GJQsqaUBKTNV-1" source="EpTUFUEd36zy79XVS4MR-30" target="EpTUFUEd36zy79XVS4MR-34">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="488.75" y="435" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="EpTUFUEd36zy79XVS4MR-30" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;Compute \(\text{E.analytic_rank_upper_bound()}\)&lt;/font&gt;" style="whiteSpace=wrap;html=1;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="59" y="357" width="290" height="70" as="geometry" />
        </mxCell>
        <mxCell id="EpTUFUEd36zy79XVS4MR-34" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;&amp;nbsp; &amp;nbsp;Output the analytic rank upper bound and the elliptic curve&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="409" y="362" width="250" height="60" as="geometry" />
