            <mxPoint x="510.5" y="1007" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="EpTUFUEd36zy79XVS4MR-28" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;The upper bound of the analytic rank is the following sum \(\text{(Bober, 2013)}\):&amp;nbsp;&lt;/font&gt;&lt;div style=&quot;font-size: 16px;&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;\[\sum_{\gamma} f_{\Delta}(\gamma) = g_{\text{an}}(\Delta, E) + u_{\text{an}} (\Delta) + n_{\text{an}} (\Delta, E)\]&lt;/font&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="313.5" y="850" width="390" height="130" as="geometry" />
        </mxCell>
