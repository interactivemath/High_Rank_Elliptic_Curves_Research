        <mxCell id="EpTUFUEd36zy79XVS4MR-27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="WIyWlLk6GJQsqaUBKTNV-1" source="EpTUFUEd36zy79XVS4MR-23" target="EpTUFUEd36zy79XVS4MR-26" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="EpTUFUEd36zy79XVS4MR-23" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;Use \(E = \text{EllipticCurve(F,P)}\), where \(P = [0,1,0]\), to find the Weierstrass form from the cubic.&amp;nbsp;&lt;/font&gt;" style="whiteSpace=wrap;html=1;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
