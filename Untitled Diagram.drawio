        </mxCell>
        <mxCell id="5lydCQstBOsYH9ejDWw0-12" value="Rewrite each of the solved coefficients from the RREF.&amp;nbsp;" style="whiteSpace=wrap;html=1;rounded=1;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
