          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ESHRiz6hZ0nK3vgfiKJN-17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="WIyWlLk6GJQsqaUBKTNV-1" source="5lydCQstBOsYH9ejDWw0-29" target="omuSJQhHvYPeHfVgWwEz-10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="5lydCQstBOsYH9ejDWw0-29" value="Assume the Generalized Riemann Hypothesis" style="whiteSpace=wrap;html=1;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="-290" y="684" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ESHRiz6hZ0nK3vgfiKJN-22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="WIyWlLk6GJQsqaUBKTNV-1" source="5lydCQstBOsYH9ejDWw0-31">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-970" y="775.3333333333335" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5lydCQstBOsYH9ejDWw0-31" value="Given we have an Elliptic curve over &lt;b&gt;Q&lt;/b&gt;, then for each prime, choose the factorization of: \(L_p((s,E) = (1 - \alpha(p) p^{-s})(1 - \beta(p)p^{-s})\). We now compute the arithmetic term: \[g_{an}(\Delta,E) = -\dfrac{1}{\Delta \pi} \sum_{p \leq \exp(2\Delta \pi)} \log p \sum_{k=1} \dfrac{k}{p^{k/2}}(\alpha (p)^k + \beta (p)^k \left(1 - \dfrac{\log p^{k/2}}{\Delta \pi}\right)\]" style="whiteSpace=wrap;html=1;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="-850" y="720" width="485" height="110" as="geometry" />
        </mxCell>
        <mxCell id="omuSJQhHvYPeHfVgWwEz-3" value="The Archimedean term is simplified to the following equation:&amp;nbsp;&lt;div&gt;\[u_{an}(\Delta) = \dfrac{\eta}{\pi^2 \Delta}&amp;nbsp; + \dfrac{1}{2\pi^3 \Delta^2} \left(\zeta(2) - \text{dilog}(e^{-2\pi\Delta})\right) \]&lt;/div&gt;" style="whiteSpace=wrap;html=1;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="-740" y="557" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="omuSJQhHvYPeHfVgWwEz-10" value="Calculate the conductor term:&amp;nbsp;&lt;div&gt;\[n_{an}(\Delta, E) = \dfrac{1}{\Delta \pi} \log \dfrac{\sqrt{N(E)}}{2\pi}\]&lt;/div&gt;" style="shape=ext;double=1;rounded=0;whiteSpace=wrap;html=1;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="-580" y="870" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ESHRiz6hZ0nK3vgfiKJN-24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="WIyWlLk6GJQsqaUBKTNV-1" source="omuSJQhHvYPeHfVgWwEz-14">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-1430" y="768" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="omuSJQhHvYPeHfVgWwEz-14" value="As \(s = 1/2 + i \gamma\) ranges over the zeros of \(L(s,E)\) , we have:&amp;nbsp;&lt;div&gt;\[\sum_{\gamma} f_{\Delta} = g_{an}(\Delta, E) + u_{an}(\Delta) + n_{an}(\Delta, E)\]&lt;/div&gt;" style="shape=ext;double=1;rounded=0;whiteSpace=wrap;html=1;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="-1320" y="719" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="omuSJQhHvYPeHfVgWwEz-15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" parent="WIyWlLk6GJQsqaUBKTNV-1" source="omuSJQhHvYPeHfVgWwEz-14" target="omuSJQhHvYPeHfVgWwEz-14" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
