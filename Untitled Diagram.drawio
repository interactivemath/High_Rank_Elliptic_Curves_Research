          <mxGeometry x="300" y="525" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="5lydCQstBOsYH9ejDWw0-30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="WIyWlLk6GJQsqaUBKTNV-1" source="5lydCQstBOsYH9ejDWw0-27" target="5lydCQstBOsYH9ejDWw0-29" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="5lydCQstBOsYH9ejDWw0-27" value="Find the analytic rank upper bound of the given curve.&amp;nbsp;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="305" y="415" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="5lydCQstBOsYH9ejDWw0-32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="WIyWlLk6GJQsqaUBKTNV-1" source="5lydCQstBOsYH9ejDWw0-29" target="5lydCQstBOsYH9ejDWw0-31" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="omuSJQhHvYPeHfVgWwEz-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="WIyWlLk6GJQsqaUBKTNV-1" source="5lydCQstBOsYH9ejDWw0-29">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="710" y="430" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5lydCQstBOsYH9ejDWw0-29" value="Assume the Generalized Riemann Hypothesis" style="whiteSpace=wrap;html=1;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="505" y="400" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="5lydCQstBOsYH9ejDWw0-31" value="Given we have an Elliptic curve over &lt;b&gt;Q&lt;/b&gt;, then for each prime, choose the factorization of: \(L_p((s,E) = (1 - \alpha(p) p^{-s})(1 - \beta(p)p^{-s})\). We now compute the arithmetic term: \[g_{an}(\Delta,E) = -\dfrac{1}{\Delta \pi} \sum_{p \leq \exp(2\Delta \pi)} \log p \sum_{k=1} \dfrac{k}{p^{k/2}}(\alpha (p)^k + \beta (p)^k \left(1 - \dfrac{\log p^{k/2}}{\Delta \pi}\right)\]" style="whiteSpace=wrap;html=1;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="580" y="170" width="725" height="120" as="geometry" />
        </mxCell>
        <mxCell id="omuSJQhHvYPeHfVgWwEz-3" value="The Archimedean term is simplified to the following equation:&amp;nbsp;&lt;div&gt;\[u_{an}(\Delta) = \dfrac{\eta}{\pi^2 \Delta}&amp;nbsp; + \dfrac{1}{2\pi^3 \Delta^2} \left(\zeta(2) - \text{dilog}(e^{-2\pi\Delta})\right) \]&lt;/div&gt;" style="whiteSpace=wrap;html=1;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="710" y="370" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="omuSJQhHvYPeHfVgWwEz-9" value="" style="edgeStyle=elbowEdgeStyle;elbow=vertical;endArrow=classic;html=1;curved=0;rounded=0;endSize=8;startSize=8;" edge="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="560" y="460.02" as="sourcePoint" />
            <mxPoint x="940" y="580" as="targetPoint" />
            <Array as="points">
              <mxPoint x="780" y="520" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="omuSJQhHvYPeHfVgWwEz-10" value="Calculate the conductor term:&amp;nbsp;&lt;div&gt;\[n_{an}(\Delta, E) = \dfrac{1}{\Delta \pi} \log \dfrac{\sqrt{N(E)}}{2\pi}\]&lt;/div&gt;" style="shape=ext;double=1;rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="720" y="585" width="580" height="155" as="geometry" />
        </mxCell>
        <mxCell id="omuSJQhHvYPeHfVgWwEz-11" value="" style="endArrow=classic;html=1;rounded=0;" edge="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="1300" y="675" as="sourcePoint" />
            <mxPoint x="1480" y="495" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="omuSJQhHvYPeHfVgWwEz-12" value="" style="endArrow=classic;html=1;rounded=0;" edge="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="1305" y="230" as="sourcePoint" />
            <mxPoint x="1470" y="370" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="omuSJQhHvYPeHfVgWwEz-13" value="" style="endArrow=classic;html=1;rounded=0;" edge="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="1070" y="430" as="sourcePoint" />
            <mxPoint x="1470" y="430" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="omuSJQhHvYPeHfVgWwEz-14" value="As \(s = 1/2 + i \gamma\) ranges over the zeros of \(L(s,E)\) , we have:&amp;nbsp;&lt;div&gt;\[\sum_{\gamma} f_{\Delta} = g_{an}(\Delta, E) + u_{an}(\Delta) + n_{an}(\Delta, E)\]&lt;/div&gt;" style="shape=ext;double=1;rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="1500" y="372" width="320" height="116" as="geometry" />
        </mxCell>
        <mxCell id="omuSJQhHvYPeHfVgWwEz-15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="WIyWlLk6GJQsqaUBKTNV-1" source="omuSJQhHvYPeHfVgWwEz-14" target="omuSJQhHvYPeHfVgWwEz-14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
