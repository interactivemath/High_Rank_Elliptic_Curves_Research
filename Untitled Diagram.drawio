          <mxGeometry x="-180" y="475" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="5lydCQstBOsYH9ejDWw0-20" value="Using \(\text{&lt;b&gt;EllipticCurve}(F,P)\), &lt;/b&gt;program, we find the Weierestrass form from the cubic." style="whiteSpace=wrap;html=1;rounded=1;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry y="473.75" width="240" height="62.5" as="geometry" />
        </mxCell>
